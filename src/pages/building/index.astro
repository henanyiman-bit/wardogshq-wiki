---
import { getEntry, render } from 'astro:content';
import WikiLayout from '../../layouts/WikiLayout.astro';
import PageSidebar from '../../components/wiki/PageSidebar.astro';

const page = await getEntry('wiki', 'building');
if (!page) throw new Error('Building page not found');
const { Content } = await render(page);
---
<WikiLayout
  title={page.data.title}
  description={page.data.description}
  canonicalPath="/building/"
  indexable={page.data.indexable}
  pageType="Article"
>
  <div class="wiki-content-grid">
    <div class="wiki-main">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">WARDOGS Wiki</a><span>›</span><span>{page.data.title}</span></nav>
      <Content />
    </div>
    <PageSidebar updated={page.data.updated} pageType={page.data.pageType} />
  </div>
</WikiLayout>
