---
const { src, alt, title, note } = Astro.props;
---
<figure class="entity-visual">
  <div class="entity-visual-stage"><img src={src} alt={alt} loading="lazy" decoding="async" fetchpriority="low" width="960" height="540" /></div>
  {(title || note) && <figcaption>{title && <strong>{title}</strong>}{note && <span>{note}</span>}</figcaption>}
</figure>
