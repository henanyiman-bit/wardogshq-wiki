---
const {
  src,
  alt,
  title,
  explanation,
  loading = 'lazy',
  fallback = '',
  fit = 'cover',
  fallbackFit = fit,
  position = 'center'
} = Astro.props;
const isRemote = /^https?:\/\//i.test(src);
const resolvedFallback = isRemote ? '/media/wiki/image-unavailable.svg' : fallback;
---
<figure class="wiki-media-figure">
  <img
    src={src}
    alt={alt}
    loading={loading}
    decoding="async"
    fetchpriority={loading === 'eager' ? 'high' : 'low'}
    width="1200"
    height="675"
    data-fallback={resolvedFallback || undefined}
    data-fallback-fit={resolvedFallback ? fallbackFit : undefined}
    style={`object-fit:${fit};object-position:${position};`}
  />
  {(title || explanation) && (
    <figcaption>
      {title && <strong>{title}</strong>}
      {explanation && <span>{explanation}</span>}
    </figcaption>
  )}
</figure>
