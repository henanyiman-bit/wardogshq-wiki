---
const { id, title, loading = 'lazy', privacyEnhanced = true } = Astro.props;
const videoHost = privacyEnhanced ? 'https://www.youtube-nocookie.com' : 'https://www.youtube.com';
---
<div class="video-wrap"><iframe src={`${videoHost}/embed/${id}`} title={title} loading={loading} referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
