---
import '../styles/global.css';
import JsonLd from '../components/seo/JsonLd.astro';
import VersionBadge from '../components/wiki/VersionBadge.astro';
const { title, description, canonicalPath='/', indexable=true, pageType='WebPage' } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={indexable ? 'index,follow' : 'noindex,follow'} />
  <link rel="canonical" href={canonical} />
  <meta property="og:url" content={canonical} />
  <JsonLd title={title} description={description} canonical={canonical} pageType={pageType}/>
</head>
<body>
<header class="site-header" data-pagefind-ignore>
  <a class="brand" href="/">WARDOGS <span>WIKI</span></a>
  <nav><a href="/money/">Money</a><a href="/map/">Map</a><a href="/loadouts/">Loadouts</a><a href="/vehicles/">Vehicles</a><a href="/weapons/">Weapons</a></nav>
</header>
<main class="shell">
  <VersionBadge />
  <article class="wiki-article" data-pagefind-body>
    <slot />
  </article>
</main>
<footer class="site-footer" data-pagefind-ignore>
  <p>Independent WARDOGS Wiki snapshot. Game facts are version-bound; unsupported values are omitted.</p>
</footer>
<script is:inline>
(() => {
  const fallback = '/media/wiki/image-unavailable.svg';
  document.querySelectorAll('img').forEach((img) => {
    if (img.dataset.safeFallbackBound === '1') return;
    img.dataset.safeFallbackBound = '1';
    const useFallback = () => {
      if (img.getAttribute('src') === fallback) return;
      img.setAttribute('src', fallback);
      img.style.objectFit = 'contain';
      img.style.objectPosition = 'center';
      img.style.padding = '18px';
      img.style.background = '#0d1216';
    };
    img.addEventListener('error', useFallback);
    if (img.complete && img.naturalWidth === 0) useFallback();
  });
})();
</script>
</body>
</html>
