{
  "name": "wardogs-wiki",
  "private": true,
  "type": "module",
  "version": "0.5.0-phase5-astro5-pinned",
  "engines": {
    "node": "18.20.8 || ^20.3.0 || >=22.0.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site dist && node -e \"require('fs').copyFileSync('dist/pagefind/pagefind-entry.json','dist/pagefind/index.json')\"",
    "search": "pagefind --site dist",
    "build:prod": "npm run check && npm run build && npm run search",
    "preview": "astro preview",
    "audit:404": "node scripts/audit-built-404.mjs dist"
  },
  "dependencies": {
    "astro": "5.16.6",
    "@astrojs/mdx": "4.2.3",
    "@astrojs/sitemap": "3.3.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "typescript": "5.9.3",
    "pagefind": "1.5.2",
    "vite": "6.4.3"
  }
}
